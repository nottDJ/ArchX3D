# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Vision response cache — content-addressed, regenerated on demand
.cache/

# Blender backups
*.blend1

# Evaluation previews and the reports scored from them — both regenerated from
# the scene graph and the .blend, and deliberately not deliverables
# (see docs/RENDER_PIPELINE.md and docs/EVALUATION.md)
output/preview/
output/evaluation/
output/refinement/
# Walkthrough frames: ~120 PNGs per build, regenerated every run.
output/frames/
output/sequence/

# Environment
.env
.env.local

# Saved API key. Written next to the data root, which is the repository itself
# when the server is run from a checkout — so without this a developer's real
# Gemini key is one `git add .` away from being published.
credentials.json

# Wizard project workspaces (uploads + per-project outputs).
#
# Anchored with a leading slash so it matches only the workspace directory at
# the repository root. Unanchored, `projects/` matches a directory of that name
# at *any* depth — which silently excluded `web/components/projects/` and
# `web/app/projects/`, the source for the Projects, Dashboard and Compare
# pages, from the repository entirely.
/projects/

# Web app
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
# CommonJS build of lib/, produced by `npm test` for the node:test runner
web/.test-build/
# Static export consumed by the desktop shell, rebuilt by `npm run build`
web/out/

# Desktop app
# Isolated interpreter the installer is built from; recreated from
# requirements.txt (see docs/DESKTOP.md)
.venv-build/
# PyInstaller intermediate and output trees
desktop/build/
desktop/dist/
desktop/testdata/
# Rust build artefacts and the generated installers
desktop/src-tauri/target/
desktop/src-tauri/binaries/
# Regenerated from tauri.conf.json on every build
desktop/src-tauri/gen/schemas/
